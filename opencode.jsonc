{
	"$schema": "https://opencode.ai/config.json",
	"instructions": ["AGENTS.md"],
	"lsp": {
		"rust": {
			"command": ["rust-analyzer"],
		},
		"deno": {
			"command": ["deno", "lsp"],
		},
	},
	"mcp": {
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true,
			"timeout": 10000,
		},
	},
}
